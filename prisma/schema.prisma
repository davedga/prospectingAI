// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Company {
  id             String        @id @default(cuid())
  name           String
  domain         String
  instagramUrl   String?
  // IG link verification (see src/lib/verify-instagram.ts). null = never
  // checked; true = handle confirmed via web search; false = could not
  // confirm (instagramUrl may have been corrected or cleared).
  instagramVerified  Boolean?
  instagramCheckedAt DateTime?
  instagramCheckNote String?
  tiktokUrl      String?
  amazonUrl      String?
  facebookUrl    String?
  websiteUrl     String
  heroSku        String?
  skuPrice       String?
  archetype      String? // "Established DTC" | "Nodpod-style emerging" | "Strategic scale" | "Fragile"
  priority       String? // "High" | "Medium-High" | "Medium" | "Low-Medium" | "Low"
  estRevenue     String?
  revenueConf    String? // "High" | "Medium" | "Low"
  ttsStatus      String?
  accountThesis  String?       @db.Text
  cogsNotes      String?       @db.Text
  parentCompany  String?
  parentRole     String? // "owns this brand" | "manages marketing budget" | "sibling brand" etc.
  siblingBrands  String[] // array of related brand names under the same parent
  status         String        @default("proposed") // proposed | selected | rejected | prospecting | prospected | outreach_active | dormant
  discoveryRunId String?
  discoveryRun   DiscoveryRun? @relation(fields: [discoveryRunId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contacts       Contact[]
  feedback       Feedback[]
  exclusionCheck ExclusionCheck?
}

model ExclusionCheck {
  id          String   @id @default(cuid())
  companyId   String   @unique
  company     Company  @relation(fields: [companyId], references: [id])
  isExcluded  Boolean
  matchedName String?
  checkedAt   DateTime @default(now())
}

model ExcludedBrand {
  id      String   @id @default(cuid())
  name    String   @unique
  source  String   @default("prior-prospects-import") // provenance: which import/tab this row came from
  // Whether this brand is a prior prospect that MAY be re-contacted, versus a
  // hard do-not-contact. Both are kept out of NEW discovery; only
  // "prior-prospect" rows are eligible for targeted re-prospecting.
  category     String  @default("do-not-contact") // "prior-prospect" | "do-not-contact"
  instagramUrl String? // kept for prior-prospect / IG-DM re-use when the source list has it
  addedAt DateTime @default(now())
}

model DiscoveryRun {
  id        String     @id @default(cuid())
  prompt    String     @db.Text // the criteria the admin gave, e.g. "beauty brands $3-30M"
  createdAt DateTime   @default(now())
  companies Company[]
  feedback  Feedback[]
}

model Contact {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  title        String
  email        String?
  emailStatus  String? // "verified" | "unavailable" | "guessed"
  linkedin     String?
  location     String?
  decisionRole String // "Economic buyer" | "Functional owner" | "Operational champion" | "Influencer/router" | "Low relevance"
  selected     Boolean  @default(false)
  apolloId     String?
  variant      String? // "A" | "B" — assigned once when A/B testing is on, reused for the whole sequence
  gmailThreadId   String? // set on first send, reused for every follow-up so the whole sequence threads together
  firstMessageId  String? // RFC Message-ID of the first-touch email, used as In-Reply-To/References on follow-ups
  repliedAt       DateTime? // set once a reply is detected in the Gmail thread — stops all further follow-ups
  createdAt    DateTime @default(now())

  emails Email[]
}

model Email {
  id              String    @id @default(cuid())
  contactId       String
  contact         Contact   @relation(fields: [contactId], references: [id])
  sequenceStep    Int // 0 = first email, 1 = follow-up 1, 2 = follow-up 2...
  subject         String
  body            String    @db.Text
  status          String    @default("draft") // draft | approved | sent | replied | bounced | cancelled
  claimsNotToMake String?   @db.Text // populated by Claude per outreach-package.md discipline
  scheduledFor    DateTime?
  sentAt          DateTime?
  approvedAt      DateTime?
  approvedBy      String?
  resendMessageId String?
  openedAt        DateTime?
  openCount       Int       @default(0)
  clickedAt       DateTime?
  clickCount      Int       @default(0)
  variant         String? // "A" | "B" — copied from Contact.variant at creation time
  createdAt       DateTime  @default(now())

  openEvents      EmailOpenEvent[]
}

// One row per open-pixel hit, so the report can show EVERY open's timestamp
// (not just the first). openedAt/openCount on Email stay as the fast summary;
// this is the detailed timeline. Historical emails sent before this existed
// simply have no events (the report falls back to Email.openedAt).
model EmailOpenEvent {
  id       String   @id @default(cuid())
  emailId  String
  email    Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)
  openedAt DateTime @default(now())

  @@index([emailId])
}

model Feedback {
  id             String        @id @default(cuid())
  scope          String // "discovery" | "prospecting" | "drafting" | "company" | "contact"
  companyId      String?
  company        Company?      @relation(fields: [companyId], references: [id])
  discoveryRunId String?
  discoveryRun   DiscoveryRun? @relation(fields: [discoveryRunId], references: [id])
  note           String        @db.Text
  createdAt      DateTime      @default(now())
}

model Settings {
  id                     String   @id @default(cuid())
  followUp1DelayDays     Int      @default(4)
  followUp2DelayDays     Int      @default(8)
  sequenceLength         Int      @default(3)
  autoDraftFirstEmails   Boolean  @default(true)
  autoGenerateFollowUps  Boolean  @default(true)
  autoApproveFirstEmails Boolean  @default(false)
  autoApproveFollowUps   Boolean  @default(false)
  emailSignature         String?  @db.Text
  emailSignatureHtml     String?  @db.Text
  standingDiscoveryBrief String?  @db.Text
  autoRunDiscovery       Boolean  @default(false)
  autoSelectDiscovered   Boolean  @default(false)
  autoProspectSelected   Boolean  @default(false)
  sendWindowStartHour    Int      @default(9)
  sendWindowEndHour      Int      @default(18)
  sendTimezone           String   @default("America/New_York")
  dailyDiscoveryLimit    Int      @default(20)
  dailyProspectLimit     Int      @default(20)
  dailyFirstEmailLimit   Int      @default(55)
  dailyFollowUpLimit     Int      @default(30)
  minDiscoveryPerRun     Int      @default(5)
  standingBriefAutoTunedAt DateTime?
  abTestingEnabled       Boolean  @default(false)
  abVariantAHint         String?  @db.Text
  abVariantBHint         String?  @db.Text
  updatedAt              DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Reporting tracks. These three tracks are lead LISTS with status fields (not
// send funnels — all email sending lives in the Email model above). They are
// imported from the local master spreadsheets by scripts/import-cmo.ts and
// scripts/import-ig.ts and surfaced read-only on the /reports page. Imports
// upsert on a natural key so re-running the daily sync never duplicates.
// ---------------------------------------------------------------------------

// Fractional CMO prospects ("All Fractional CMOs" sheet).
model CmoLead {
  id               String   @id @default(cuid())
  seq              Int? // "#" column from the sheet, for stable ordering
  name             String
  status           String? // e.g. "Vetted — list 2 (Sep 28)"
  fit              Int? // "Fit (1-5)"
  consumerSignals  String?  @db.Text
  linkedin         String?
  email            String?
  emailStatus      String? // "Verified" | "Guessed" | ...
  location         String?
  apolloTitle      String?
  headline         String?  @db.Text
  firm             String?
  firmIndustry     String?
  currentRoles     String?  @db.Text
  currentClients   String?  @db.Text
  clientsContacted String?  @db.Text // "Clients DGA already contacted"
  notes            String?  @db.Text
  inBroadSearch    Boolean  @default(false) // "In 368-person search" == Yes
  source           String   @default("cmo-master-import")
  importedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Natural key for idempotent upsert: email when present, else linkedin.
  dedupeKey String @unique
}

// Vetted client brands tied to the CMO track ("Client Brands (vetted)" sheet).
model CmoClientBrand {
  id               String   @id @default(cuid())
  brand            String
  website          String?
  category         String?
  relationship     String? // "Current" | "Past" | ...
  ttsStatus        String? // TikTok Shop status
  alreadyContacted String? // "Already contacted by DGA"
  cmoName          String?
  cmoFit           Int?
  cmoLinkedin      String?
  cmoEmail         String?
  fromList         String?
  source           String   @default("cmo-master-import")
  importedAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dedupeKey String @unique // normalized brand name
}

// Instagram DM leads worked by Cam ("Master" sheet).
model IgDmLead {
  id                String   @id @default(cuid())
  seq               Int? // "#" column
  batchDate         String? // kept as the sheet's string, e.g. "2026-09-28"
  brand             String
  category          String?
  website           String?
  igHandle          String?
  igUrl             String?
  tiktokHandle      String?
  ttsStatus         String? // "TikTok Shop Status"
  ttsEvidence       String?  @db.Text
  revenueBasis      String?  @db.Text // "7-Figure Basis (estimate)"
  revenueConfidence String? // "High" | "Medium" | "Low"
  usHq              String?
  camDmStatus       String? // "Cam DM Status" — the IG outreach state
  notes             String?  @db.Text
  // Set by the in-app generator (source="in-app-gen"): the IG handle was
  // confirmed/corrected via live web search, not guessed. Spreadsheet imports
  // leave these null.
  igVerified        Boolean? @default(false)
  igVerifyNote      String?  @db.Text
  source            String   @default("ig-master-import")
  importedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dedupeKey String @unique // igUrl when present, else normalized brand
}

// One row per day of the headline reporting numbers, written by
// scripts/snapshot-metrics.ts, so /reports can show day-over-day deltas
// without recomputing history.
model MetricSnapshot {
  id        String   @id @default(cuid())
  date      String   @unique // YYYY-MM-DD (America/New_York)
  payload   Json
  createdAt DateTime @default(now())
}
